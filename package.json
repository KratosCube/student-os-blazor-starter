{
  "name": "student-os-blazor",
  "private": true,
  "scripts": {
    "icons:copy": "mkdir -p wwwroot/vendor/bootstrap-icons && cp -r node_modules/bootstrap-icons/font/* wwwroot/vendor/bootstrap-icons/",
    "css:build": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "bootstrap-icons": "^1.13.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.1"
  }
}
