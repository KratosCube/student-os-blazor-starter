@page "/stats"
@using StudentOs.Blazor.Components.Shared
@inject DashboardService DashboardService

<PageTitle>Stats</PageTitle>

@if (_vm is null)
{
    <div class="ui-card p-6">
        <p class="ui-text-secondary">Načítám statistiky...</p>
    </div>
}
else
{
    @*
        Stats stránka slouží pro detailnější vyhodnocení studia
    *@
    <div class="space-y-5">
        <section class="ui-card p-6">
            <p class="ui-eyebrow">Stats</p>

            <h2 class="ui-page-title mt-2">
                Statistiky a odměny
            </h2>
        </section>

        @*
            Vybraný týden se mění pomocí šipek nebo ručního výběru data
        *@
        <section class="grid gap-4 md:grid-cols-3">
            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <i class="bi bi-calendar-week text-xl text-indigo-500" aria-hidden="true"></i>

                    <p class="ui-metric-label">
                        Vybraný týden
                    </p>
                </div>

                <p class="ui-metric-value mt-3">
                    @FormatMinutes(SelectedWeekMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <i class="bi bi-clock-history text-xl text-indigo-500" aria-hidden="true"></i>

                    <p class="ui-metric-label">
                        Celkem odstudováno
                    </p>
                </div>

                <p class="ui-metric-value mt-3">
                    @FormatMinutes(_vm.LifetimeMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <i class="bi bi-stars text-xl text-indigo-500" aria-hidden="true"></i>

                    <p class="ui-metric-label">
                        Kredity
                    </p>
                </div>

                <p class="ui-metric-value mt-3">
                    @_vm.TotalLifetimeCredits
                </p>
            </div>
        </section>

        <StudyBarChart
            Title="@ChartTitle"
            Description="@ChartDescription"
            Items="@ChartItems">
            <HeaderActions>
                <button type="button"
                        class="@GetModeButtonClass(StatsChartMode.Week)"
                        @onclick="() => SetMode(StatsChartMode.Week)">
                    Po týdnu
                </button>

                <button type="button"
                        class="@GetModeButtonClass(StatsChartMode.Subjects)"
                        @onclick="() => SetMode(StatsChartMode.Subjects)">
                    Podle předmětů
                </button>

                @if (_mode == StatsChartMode.Week)
                {
                    @*
                        Ovládání týdenního grafu
                        Šipky posouvají týden dopředu/dozadu
                    *@
                    <div class="flex flex-wrap gap-2">
                        <button type="button"
                                class="ui-btn-secondary"
                                title="Předchozí týden"
                                @onclick="PreviousWeek">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>

                        <input type="date"
                               value="@WeekPickerValue"
                               max="@TodayPickerValue"
                               @onchange="OnWeekPickerDateChanged"
                               class="ui-week-picker-input"
                               title="@WeekRangeTitle" />

                        <button type="button"
                                class="@NextWeekButtonClass"
                                title="Další týden"
                                disabled="@IsCurrentWeekSelected"
                                @onclick="NextWeek">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </HeaderActions>
        </StudyBarChart>

        <RewardShop TotalLifetimeCredits="_vm.TotalLifetimeCredits" />
    </div>
}

@code {
    private DashboardVm? _vm;

    private StatsChartMode _mode = StatsChartMode.Week;
    private DateTime _weekStart = GetStartOfWeek(DateTime.Today);
    private readonly System.Globalization.CultureInfo _cs = new("cs-CZ");

    // Při načtení stránky se načtou data z DashboardService
    protected override async Task OnInitializedAsync()
    {
        _vm = await DashboardService.GetDashboardAsync();
        _weekStart = GetStartOfWeek(DateTime.Today);
    }

    // Vybere aktuální data pro graf podle zapnutého režimu
    private List<ChartItemVm> ChartItems
    {
        get
        {
            if (_vm is null)
            {
                return new List<ChartItemVm>();
            }

            if (_mode == StatsChartMode.Subjects)
            {
                return _vm.SubjectSeries;
            }

            return SelectedWeekSeries;
        }
    }

    // Vytvoří graph series pro aktuálně vybraný týden
    private List<ChartItemVm> SelectedWeekSeries
    {
        get
        {
            if (_vm is null)
            {
                return new List<ChartItemVm>();
            }

            return BuildWeekSeries(_vm.Subjects, _weekStart);
        }
    }

    // Součet minut ve vybraném týdnu
    private int SelectedWeekMinutes
    {
        get
        {
            return SelectedWeekSeries.Sum(chartItem => chartItem.TotalValue);
        }
    }

    private string ChartTitle
    {
        get
        {
            if (_mode == StatsChartMode.Subjects)
            {
                return "Studium podle předmětů";
            }

            return "Studium po týdnech";
        }
    }

    private string ChartDescription
    {
        get
        {
            if (_mode == StatsChartMode.Subjects)
            {
                return "Souhrn celkového času podle jednotlivých předmětů.";
            }

            return $"Týden od {_weekStart.ToString("d. M. yyyy", _cs)} do {_weekStart.AddDays(6).ToString("d. M. yyyy", _cs)}.";
        }
    }

    private string TodayPickerValue
    {
        get
        {
            return DateTime.Today.ToString("yyyy-MM-dd");
        }
    }

    private string WeekRangeTitle
    {
        get
        {
            return $"{_weekStart.ToString("d. M. yyyy", _cs)} – {_weekStart.AddDays(6).ToString("d. M. yyyy", _cs)}";
        }
    }

    // Hodnota date pickeru je pondělí vybraného týdne.
    private string WeekPickerValue
    {
        get
        {
            return _weekStart.ToString("yyyy-MM-dd");
        }
    }

    // Aktuální týden je horní limit
    private bool IsCurrentWeekSelected
    {
        get
        {
            return _weekStart.Date >= GetStartOfWeek(DateTime.Today);
        }
    }

    private string NextWeekButtonClass
    {
        get
        {
            if (IsCurrentWeekSelected)
            {
                return "ui-btn-secondary cursor-not-allowed opacity-50";
            }

            return "ui-btn-secondary";
        }
    }

    // Přepíná grafy 
    private void SetMode(StatsChartMode mode)
    {
        _mode = mode;
    }

    // Posune týden zpět
    private void PreviousWeek()
    {
        _weekStart = _weekStart.AddDays(-7);
    }

    // Posune týdenní graf o jeden týden dopředu
    private void NextWeek()
    {
        if (IsCurrentWeekSelected)
        {
            return;
        }

        _weekStart = _weekStart.AddDays(7);
    }

    private void OnWeekPickerDateChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();

        if (!DateTime.TryParse(raw, out var selectedDate))
        {
            return;
        }

        var selectedWeek = GetStartOfWeek(selectedDate);
        var currentWeek = GetStartOfWeek(DateTime.Today);

        if (selectedWeek > currentWeek)
        {
            _weekStart = currentWeek;
            return;
        }

        _weekStart = selectedWeek;
    }

    // Aktivní přepínač grafu má primární styl
    private string GetModeButtonClass(StatsChartMode mode)
    {
        if (_mode == mode)
        {
            return "ui-btn-primary";
        }

        return "ui-btn-secondary";
    }

    // Vytvoří graph series pro sedm dní od zadaného dne (od pondělí týdne ve kterém je vybraný den)
    private static List<ChartItemVm> BuildWeekSeries(List<Subject> subjects, DateTime weekStart)
    {
        return Enumerable
            .Range(0, 7)
            .Select(dayIndex =>
            {
                var day = weekStart.Date.AddDays(dayIndex);

                var sessionsForDay = subjects
                    .SelectMany(subject =>
                        subject.Sessions
                            .Where(session => session.CreatedAt.Date == day)
                            .Select(session => new
                            {
                                subject.Name,
                                subject.Color,
                                session.Duration
                            })
                    );

                var segments = sessionsForDay
                    .GroupBy(session => new { session.Name, session.Color })
                    .Select(group => new ChartSegmentVm(
                        group.Key.Name,
                        group.Sum(session => session.Duration),
                        group.Key.Color
                    ))
                    .ToList();

                return new ChartItemVm(day.ToString("dd.MM"), segments);
            })
            .ToList();
    }

    // Vrátí pondělí týdne, do kterého patří zadané datum
    private static DateTime GetStartOfWeek(DateTime date)
    {
        var diff = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;

        return date.Date.AddDays(-diff);
    }

    private static string FormatMinutes(int totalMinutes)
    {
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;

        return $"{hours}h {minutes}m";
    }

    private enum StatsChartMode
    {
        Week,
        Subjects
    }
}
