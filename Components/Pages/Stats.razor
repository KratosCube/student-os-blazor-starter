@page "/stats"
@using StudentOs.Blazor.Components.Shared
@inject DashboardService DashboardService

<PageTitle>Stats</PageTitle>

@if (_vm is null)
{
    <div class="ui-card p-6">
        <p class="ui-text-secondary">Načítám statistiky...</p>
    </div>
}
else
{
    <div class="space-y-5">
        <section class="ui-card p-6">
            <p class="ui-eyebrow">Stats</p>
            <h2 class="ui-page-title mt-2">Statistiky a odměny</h2>
        </section>

        <section class="grid gap-4 md:grid-cols-3">
            <div class="ui-card p-5">
                <p class="ui-metric-label">Vybraný týden</p>
                <p class="ui-metric-value mt-3">
                    @FormatMinutes(SelectedWeekMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <p class="ui-metric-label">Celkem odstudováno</p>
                <p class="ui-metric-value mt-3">
                    @FormatMinutes(_vm.LifetimeMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <p class="ui-metric-label">Kredity</p>
                <p class="ui-metric-value mt-3">@_vm.TotalLifetimeCredits</p>
            </div>
        </section>

        <StudyBarChart
            Title="@ChartTitle"
            Description="@ChartDescription"
            Items="@ChartItems">
            <HeaderActions>
                <button type="button"
                        class="@GetModeButtonClass(StatsChartMode.Week)"
                        @onclick="() => SetMode(StatsChartMode.Week)">
                    Po týdnu
                </button>

                <button type="button"
                        class="@GetModeButtonClass(StatsChartMode.Subjects)"
                        @onclick="() => SetMode(StatsChartMode.Subjects)">
                    Podle předmětů
                </button>

                @if (_mode == StatsChartMode.Week)
                {
                    <div class="flex flex-wrap gap-2">
                        <button type="button"
                                class="ui-btn-secondary"
                                title="Předchozí týden"
                                @onclick="PreviousWeek">
                            ←
                        </button>

                       <div class="relative">
    <input type="date"
       value="@WeekPickerValue"
       max="@TodayPickerValue"
       @onchange="OnWeekPickerDateChanged"
       class="ui-week-picker-input"
       title="@WeekRangeTitle" />

    @if (_showWeekPicker)
    {
        <div class="ui-card absolute right-0 z-20 mt-2 w-64 p-4 shadow-lg">
            <label class="ui-label">Vyber den</label>

            <input type="date"
                   value="@WeekPickerValue"
                   @onchange="OnWeekPickerDateChanged"
                   class="ui-input" />

            <p class="ui-text-helper mt-2">
                Zobrazí se týden, do kterého vybraný den patří.
            </p>
        </div>
    }
</div>

                        <button type="button"
                                class="@NextWeekButtonClass"
                                title="Další týden"
                                disabled="@IsCurrentWeekSelected"
                                @onclick="NextWeek">
                            →
                        </button>
                    </div>
                }
            </HeaderActions>
        </StudyBarChart>

        <RewardShop TotalLifetimeCredits="_vm.TotalLifetimeCredits" />
    </div>
}

@code {
    private DashboardVm? _vm;

    private StatsChartMode _mode = StatsChartMode.Week;
    private DateTime _weekStart = GetStartOfWeek(DateTime.Today);
    private bool _showWeekPicker;
    private readonly System.Globalization.CultureInfo _cs = new("cs-CZ");

    protected override async Task OnInitializedAsync()
    {
        _vm = await DashboardService.GetDashboardAsync();
        _weekStart = GetStartOfWeek(DateTime.Today);
    }

    private List<ChartItemVm> ChartItems => _vm is null
        ? new List<ChartItemVm>()
        : _mode switch
        {
            StatsChartMode.Subjects => _vm.SubjectSeries,
            _ => SelectedWeekSeries
        };

    private List<ChartItemVm> SelectedWeekSeries => _vm is null
        ? new List<ChartItemVm>()
        : BuildWeekSeries(_vm.Subjects, _weekStart);

    private int SelectedWeekMinutes => SelectedWeekSeries.Sum(x => x.TotalValue);

    private string ChartTitle => _mode switch
    {
        StatsChartMode.Subjects => "Studium podle předmětů",
        _ => "Studium po týdnech"
    };

    private string ChartDescription => _mode switch
    {
        StatsChartMode.Subjects => "Souhrn celkového času podle jednotlivých předmětů.",
        _ => $"Týden od {_weekStart.ToString("d. M. yyyy", _cs)} do {_weekStart.AddDays(6).ToString("d. M. yyyy", _cs)}."
    };

    private string TodayPickerValue => DateTime.Today.ToString("yyyy-MM-dd");
   
    private string WeekRangeTitle =>
    $"{_weekStart.ToString("d. M. yyyy", _cs)} – {_weekStart.AddDays(6).ToString("d. M. yyyy", _cs)}";
    private string WeekPickerValue => _weekStart.ToString("yyyy-MM-dd");
    private bool IsCurrentWeekSelected => _weekStart.Date >= GetStartOfWeek(DateTime.Today);

    private string NextWeekButtonClass => IsCurrentWeekSelected
        ? "ui-btn-secondary cursor-not-allowed opacity-50"
        : "ui-btn-secondary";

    private void SetMode(StatsChartMode mode)
    {
        _mode = mode;
        _showWeekPicker = false;
    }

    private void PreviousWeek()
    {
        _weekStart = _weekStart.AddDays(-7);
        _showWeekPicker = false;
    }

    private void NextWeek()
    {
        if (IsCurrentWeekSelected)
            return;

        _weekStart = _weekStart.AddDays(7);
        _showWeekPicker = false;
    }
    private void ToggleWeekPicker()
{
    _showWeekPicker = !_showWeekPicker;
}

private void OnWeekPickerDateChanged(ChangeEventArgs e)
{
    var raw = e.Value?.ToString();

    if (!DateTime.TryParse(raw, out var selectedDate))
        return;

    var selectedWeek = GetStartOfWeek(selectedDate);
    var currentWeek = GetStartOfWeek(DateTime.Today);

    _weekStart = selectedWeek > currentWeek
        ? currentWeek
        : selectedWeek;

    _showWeekPicker = false;
}
    private string GetModeButtonClass(StatsChartMode mode)
    {
        return _mode == mode
            ? "ui-btn-primary"
            : "ui-btn-secondary";
    }

    private static List<ChartItemVm> BuildWeekSeries(List<Subject> subjects, DateTime weekStart)
    {
        return Enumerable
            .Range(0, 7)
            .Select(index =>
            {
                var day = weekStart.Date.AddDays(index);

                var segments = subjects
                    .SelectMany(subject =>
                        subject.Sessions
                            .Where(session => session.CreatedAt.Date == day)
                            .Select(session => new
                            {
                                subject.Name,
                                subject.Color,
                                session.Duration
                            })
                    )
                    .GroupBy(x => new { x.Name, x.Color })
                    .Select(group => new ChartSegmentVm(
                        group.Key.Name,
                        group.Sum(x => x.Duration),
                        group.Key.Color
                    ))
                    .ToList();

                return new ChartItemVm(day.ToString("dd.MM"), segments);
            })
            .ToList();
    }

    private static DateTime GetStartOfWeek(DateTime date)
    {
        var diff = ((int)date.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return date.Date.AddDays(-diff);
    }

    private static string FormatMinutes(int totalMinutes)
    {
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        return $"{hours}h {minutes}m";
    }

    private enum StatsChartMode
    {
        Week,
        Subjects
    }
}
