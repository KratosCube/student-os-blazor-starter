@page "/"
@using StudentOs.Blazor.Components.Shared
@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

@if (_vm is null)
{
    <div class="ui-card p-6">
        <p class="ui-text-secondary">Načítám dashboard...</p>
    </div>
}
else
{
    <div class="space-y-5">
        <section class="ui-card p-6">
            <p class="ui-eyebrow">Dashboard</p>
            <h2 class="ui-page-title mt-2">Přehled dne</h2>
        </section>

        <section class="grid gap-4 md:grid-cols-3">
            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 3"></path>
                    </svg>
                    <p class="ui-metric-label">Dnes odstudováno</p>
                </div>

                <p class="ui-metric-value mt-4">
                    @FormatMinutes(_vm.TodayTotalMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <path d="M16 2v4M8 2v4M3 10h18"></path>
                    </svg>
                    <p class="ui-metric-label">Týden celkem</p>
                </div>

                <p class="ui-metric-value mt-4">
                    @FormatMinutes(_vm.WeekTotalMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 10v6M2 10v6"></path>
                        <path d="M6 12l6-3 6 3-6 3-6-3Z"></path>
                        <path d="M6 12v4l6 3 6-3v-4"></path>
                    </svg>
                    <p class="ui-metric-label">Celkem</p>
                </div>

                <p class="ui-metric-value mt-4">
                    @FormatMinutes(_vm.LifetimeMinutes)
                </p>
            </div>
        </section>

        <section class="grid items-start gap-5 xl:grid-cols-[260px,1fr]">
            <div class="space-y-5">
                <FocusTimer Subjects="_vm.Subjects" />
                <GoalTracker TodayMinutes="_vm.TodayTotalMinutes" />
                <HydrationTracker />
            </div>

            <div class="space-y-5">
                

                <StudyBarChart
    Title="Studium za poslední týden"
    Description="Přehled aktivity po dnech."
    Items="_vm.WeeklySeries" />

<div class="ui-card p-6">
    <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h3 class="ui-section-title">Nejbližší termíny</h3>
            <p class="ui-text-secondary mt-2">
                Aktivní termíny na dnešek a následujících 14 dní.
            </p>
        </div>

        <span class="ui-badge bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-200">
            @DashboardExamCount aktivních
        </span>
    </div>

    @if (DashboardExamCount == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-8 text-center dark:border-slate-700 dark:bg-slate-950/60">
            <p class="font-semibold text-slate-700 dark:text-slate-200">
                Žádné blízké termíny
            </p>
            <p class="ui-text-secondary mt-2">
                V příštích 14 dnech nemáš žádný aktivní termín.
            </p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var exam in DashboardExams)
            {
                var isToday = exam.Date.Date == DateTime.Now.Date;
                var cardClass = isToday
                    ? "rounded-xl border border-amber-200/70 bg-amber-50/70 p-4 dark:border-amber-900/40 dark:bg-amber-900/10"
                    : "rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/50";

                <div class="@cardClass">
                    <div class="flex flex-wrap items-start gap-4">
                        <div class="h-11 w-1.5 shrink-0 rounded-full"
                             style="background-color:@(exam.Subject?.Color ?? "#6366f1")">
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <p class="text-lg font-semibold text-slate-800 dark:text-slate-100">
                                    @(exam.Subject?.Name ?? "Bez předmětu")
                                </p>

                                <span class="@GetDateBadgeClass(exam.Date)">
                                    @FormatDaysUntil(exam.Date)
                                </span>

                                <span class="ui-badge bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                                    @(exam.Type == "confirmed" ? "Potvrzeno" : "Možné")
                                </span>
                            </div>

                            <p class="ui-text-secondary mt-1">
                                @exam.Date.ToString("d. M. yyyy HH:mm", _cs) · @exam.Duration min
                            </p>

                            @if (!string.IsNullOrWhiteSpace(exam.Note))
                            {
                                <p class="ui-text-secondary mt-3"
                                   style="white-space: pre-line; overflow-wrap: anywhere;">
                                    @exam.Note
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<QuickNotes />            </div>
        </section>
    </div>
}

@code {
    private DashboardVm? _vm;

    private readonly System.Globalization.CultureInfo _cs = new("cs-CZ");

    protected override async Task OnInitializedAsync()
    {
        _vm = await DashboardService.GetDashboardAsync();
    }

    private IEnumerable<Exam> DashboardExams => _vm is null
        ? Enumerable.Empty<Exam>()
        : _vm.TodayExams
            .Concat(_vm.UpcomingExams)
            .OrderBy(x => x.Date);

    private int DashboardExamCount => _vm is null
        ? 0
        : _vm.TodayExams.Count + _vm.UpcomingExams.Count;



    private static string GetDateBadgeClass(DateTime date)
    {
        return date.Date == DateTime.Now.Date
            ? "ui-badge bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"
            : "ui-badge bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-300";
    }

    private static string FormatMinutes(int totalMinutes)
    {
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;
        return $"{hours}h {minutes}m";
    }

    private static string FormatDaysUntil(DateTime date)
    {
        var days = (date.Date - DateTime.Now.Date).Days;

        return days switch
        {
            <= 0 => "Dnes",
            1 => "Zítra",
            2 or 3 or 4 => $"Za {days} dny",
            _ => $"Za {days} dní"
        };
    }

    
}
