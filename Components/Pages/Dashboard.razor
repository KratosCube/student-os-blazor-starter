@page "/"
@using StudentOs.Blazor.Components.Shared
@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

@if (_vm is null)
{
    <div class="ui-card p-6">
        <p class="ui-text-secondary">Načítám dashboard...</p>
    </div>
}
else
{
    @*
        Dashboard je hlavní přehled aplikace. Zobrazuje souhrny studia, timer, denní progres,
        pitný režim, graf za poslední týden, nejbližší termíny a rychlé poznámky.
    *@
    <div class="space-y-5">
        <section class="ui-card p-6">
            <p class="ui-eyebrow">Dashboard</p>
            <h2 class="ui-page-title mt-2">Přehled dne</h2>
        </section>

        <section class="grid gap-4 md:grid-cols-3">
            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <i class="bi bi-clock-history text-xl text-indigo-500" aria-hidden="true"></i>                    <p class="ui-metric-label">Dnes odstudováno</p>
                </div>

                <p class="ui-metric-value mt-4">
                    @FormatMinutes(_vm.TodayTotalMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <i class="bi bi-calendar-week text-xl text-indigo-500" aria-hidden="true"></i>
                    <p class="ui-metric-label">Týden celkem</p>
                </div>

                <p class="ui-metric-value mt-4">
                    @FormatMinutes(_vm.WeekTotalMinutes)
                </p>
            </div>

            <div class="ui-card p-5">
                <div class="flex items-center gap-3">
                    <i class="bi bi-mortarboard text-xl text-indigo-500" aria-hidden="true"></i>
                    <p class="ui-metric-label">Celkem</p>
                </div>

                <p class="ui-metric-value mt-4">
                    @FormatMinutes(_vm.LifetimeMinutes)
                </p>
            </div>
        </section>

        @*
            Hlavní část dashboardu je rozdělena na levý sloupec s aktivními widgety
            a pravou část s grafem, termíny a poznámkami.
        *@
        <section class="grid items-start gap-5 xl:grid-cols-[260px,1fr]">
            <div class="space-y-5">
                <FocusTimer Subjects="@ActiveSubjects" />
                <GoalTracker TodayMinutes="_vm.TodayTotalMinutes" />
                <HydrationTracker />
            </div>

            <div class="space-y-5">
                <StudyBarChart
                    Title="Studium za poslední týden"
                    Items="_vm.WeeklySeries" />

                <div class="ui-card p-6">
                    <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
                        <div>
                            <h3 class="ui-section-title">Nejbližší termíny</h3>
                        </div>

                        <span class="ui-badge ui-badge-neutral">
                            @DashboardExamCount aktivních
                        </span>
                    </div>

                    @if (DashboardExamCount == 0)
                    {
                        <div class="ui-empty-state">
                            <p class="font-semibold text-slate-700 dark:text-slate-200">
                                Žádné blízké termíny
                            </p>
                            <p class="ui-text-secondary mt-2">
                                V příštích 14 dnech nemáš žádný aktivní termín.
                            </p>
                        </div>
                    }
                    else
                    {
                        
                        @*
                            Dashboard ukazuje dnešní termíny a aktivní termíny v nejbližších 14 dnech.
                            Dnešní termíny jsou označené jiným stylem karty.
                        *@
                        <div class="space-y-3">
                            @foreach (var exam in DashboardExams)
                            {
                                var isToday = exam.Date.Date == DateTime.Now.Date;
                                var cardClass = isToday ? "ui-list-item-warning" : "ui-list-item";

                                <div class="@cardClass">
                                    <div class="flex flex-wrap items-start gap-4">
                                        <div class="h-11 w-1.5 shrink-0 rounded-full"
                                             style="background-color:@(exam.Subject?.Color ?? "#6366f1")">
                                        </div>

                                        <div class="min-w-0 flex-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <p class="text-lg font-semibold text-slate-800 dark:text-slate-100">
                                                    @(exam.Subject?.Name ?? "Bez předmětu")
                                                </p>

                                                <span class="@GetDateBadgeClass(exam.Date)">
                                                    @FormatDaysUntil(exam.Date)
                                                </span>

                                                <span class="ui-badge ui-badge-neutral">
                                                    @(exam.Type == "confirmed" ? "Potvrzeno" : "Možné")
                                                </span>
                                            </div>

                                            <p class="ui-text-secondary mt-1">
                                                @exam.Date.ToString("d. M. yyyy HH:mm", _cs) · @exam.Duration min
                                            </p>

                                            @if (!string.IsNullOrWhiteSpace(exam.Note))
                                            {
                                                <p class="ui-note-text">
                                                    @exam.Note
                                                </p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <QuickNotes />
            </div>
        </section>
    </div>
}

@code {
    private DashboardVm? _vm;
    private readonly System.Globalization.CultureInfo _cs = new("cs-CZ");

    protected override async Task OnInitializedAsync()
    {
        _vm = await DashboardService.GetDashboardAsync();
    }

    private List<Subject> ActiveSubjects
    {
        get
        {
            if (_vm is null)
            {
                return new List<Subject>();
            }

            return _vm.Subjects.Where(x => !x.IsArchived).ToList();
        }
    }

    private IEnumerable<Exam> DashboardExams
    {
        get
        {
            if (_vm is null)
            {
                return Enumerable.Empty<Exam>();
            }

            return _vm.TodayExams.Concat(_vm.UpcomingExams).Take(6);
        }
    }

    private int DashboardExamCount
    {
        get
        {
            return DashboardExams.Count();
        }
    }

    private static string FormatMinutes(int totalMinutes)
    {
        var hours = totalMinutes / 60;
        var minutes = totalMinutes % 60;

        return $"{hours}h {minutes}m";
    }

    private static string FormatDaysUntil(DateTime date)
    {
        var difference = (date.Date - DateTime.Now.Date).Days;

        if (difference == 0)
        {
            return "Dnes";
        }

        if (difference == 1)
        {
            return "Zítra";
        }

        if (difference > 1)
        {
            return $"Za {difference} dny";
        }

        return "Po termínu";
    }

    private static string GetDateBadgeClass(DateTime date)
    {
        var difference = (date.Date - DateTime.Now.Date).Days;

        if (difference == 0)
        {
            return "ui-badge ui-badge-warning";
        }

        if (difference < 0)
        {
            return "ui-badge ui-badge-neutral";
        }

        return "ui-badge ui-badge-primary";
    }
}
