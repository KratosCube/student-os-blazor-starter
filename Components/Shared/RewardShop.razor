@inject BrowserStorageService Storage
@inject IJSRuntime JS

@if (_isMounted)
{
    @*
        RewardShop zobrazuje odměny, které si student může koupit za kredity
    *@
    <div id="reward-shop"
         class="ui-card scroll-mt-5 p-6">
        <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="ui-eyebrow">
                    Reward shop
                </p>

                <h3 class="ui-section-title mt-2">
                    Odměny za studium
                </h3>
            </div>

            <span class="ui-badge ui-badge-primary">
                @FormatCredits(CurrentBalance)
            </span>
        </div>

        @if (_rewards.Count == 0)
        {
            <div class="ui-empty-state">
                Zatím nejsou vytvořené žádné odměny.
            </div>
        }
        else
        {
          @*
                Odměny se na menší šířce rozdělí do dvou sloupců.
          *@
            <div class="grid gap-3 lg:grid-cols-2">
                @foreach (var reward in _rewards)
                {
                    var canBuy = CurrentBalance >= reward.Cost;

                    <div class="ui-list-item">
                        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                            <div class="min-w-0">
                                <p class="truncate font-semibold text-slate-800 dark:text-slate-100">
                                    @reward.Name
                                </p>

                                <div class="mt-2 flex flex-wrap items-center gap-2">
                                    <span class="ui-text-helper">
                                        Cena:
                                    </span>

                                    <span class="ui-badge @(canBuy ? "ui-badge-primary" : "ui-badge-neutral")">
                                        @FormatCredits(reward.Cost)
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-wrap gap-2 md:shrink-0">
                                <button type="button"
                                        class="@GetBuyButtonClass(canBuy)"
                                        disabled="@(!canBuy)"
                                        @onclick="() => BuyRewardAsync(reward)">
                                    Koupit
                                </button>

                                <button type="button"
                                        class="ui-btn-small ui-btn-secondary"
                                        @onclick="() => DeleteRewardAsync(reward.Id)">
                                    Smazat
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_isAdding)
        {
            @*
                Formulář pro vytvoření vlastní odměny
            *@
            <div class="ui-card-soft mt-4 p-4">
                <div class="grid gap-3 md:grid-cols-[1fr_120px]">
                    <div>
                        <label class="ui-label">
                            Název odměny
                        </label>

                        <input class="ui-input"
                               @bind="_newRewardName"
                               placeholder="Např. káva, pauza, epizoda seriálu..."
                               autofocus />
                    </div>

                    <div>
                        <label class="ui-label">
                            Cena
                        </label>

                        <input class="ui-input"
                               @bind="_newRewardCost"
                               type="number"
                               min="1" />
                    </div>
                </div>

                <div class="mt-4 flex flex-wrap gap-3">
                    <button type="button"
                            class="ui-btn-primary"
                            @onclick="AddRewardAsync">
                        Přidat
                    </button>

                    <button type="button"
                            class="ui-btn-secondary"
                            @onclick="CancelAddReward">
                        Zrušit
                    </button>
                </div>
            </div>
        }
        else
        {
            <button type="button"
                    class="ui-btn-secondary mt-4 w-full"
                    @onclick="() => _isAdding = true">
                Přidat vlastní odměnu
            </button>
        }
    </div>
}

@code {
    [Parameter]
    public int TotalLifetimeCredits { get; set; }

    private int _spentCredits;
    private bool _isMounted;
    private bool _isAdding;
    private string _newRewardName = string.Empty;
    private int _newRewardCost = 1;

    private List<RewardItem> _rewards = DefaultRewards
        .Select(reward => new RewardItem
        {
            Id = reward.Id,
            Name = reward.Name,
            Cost = reward.Cost
        })
        .ToList();

    // Dostupné kredity jsou celkové získané kredity mínus kredity utracené za odměny
    private int CurrentBalance
    {
        get
        {
            return Math.Max(0, TotalLifetimeCredits - _spentCredits);
        }
    }

    private static readonly List<RewardItem> DefaultRewards =
    [
        new() { Id = "1", Name = "Epizoda seriálu", Cost = 1 },
        new() { Id = "2", Name = "Káva nebo snack", Cost = 1 },
        new() { Id = "3", Name = "Hraní her 30 minut", Cost = 2 },
        new() { Id = "4", Name = "Delší pauza", Cost = 3 },
        new() { Id = "5", Name = "Kino nebo akce", Cost = 6 }
    ];

    // Po prvním renderu se načtou utracené kredity a případné vlastní odměny z localStorage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var savedSpent = await Storage.GetStringAsync("userSpentCredits");
        var savedRewards = await Storage.GetObjectAsync<List<RewardItem>>("userCustomRewards");

        if (int.TryParse(savedSpent, out var parsedSpent))
        {
            _spentCredits = parsedSpent;
        }

        if (savedRewards is { Count: > 0 })
        {
            _rewards = savedRewards;
        }

        _isMounted = true;
        StateHasChanged();
    }

    // Koupí odměnu, pokud má uživatel dost kreditů
    private async Task BuyRewardAsync(RewardItem reward)
    {
        if (CurrentBalance < reward.Cost)
        {
            await JS.InvokeVoidAsync("alert", "Na tuto odměnu nemáš dost kreditů.");
            return;
        }

        var confirm = await JS.InvokeAsync<bool>(
            "confirm",
            $"Opravdu chceš koupit odměnu \"{reward.Name}\" za {FormatCredits(reward.Cost)}?"
        );

        if (!confirm)
        {
            return;
        }

        _spentCredits += reward.Cost;
        await Storage.SetStringAsync("userSpentCredits", _spentCredits.ToString());
    }

    // Přidá novou vlastní odměnu do seznamu
    // Cena je minimálně 1 kredit, aby nevznikaly nesmyslné nulové nebo záporné ceny
    private async Task AddRewardAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRewardName))
        {
            return;
        }

        var reward = new RewardItem
        {
            Id = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString(),
            Name = _newRewardName.Trim(),
            Cost = Math.Max(1, _newRewardCost)
        };

        _rewards.Add(reward);

        await Storage.SetObjectAsync("userCustomRewards", _rewards);

        _newRewardName = string.Empty;
        _newRewardCost = 1;
        _isAdding = false;
    }

    // Zavře formulář a vyčistí rozepsané hodnoty
    private void CancelAddReward()
    {
        _newRewardName = string.Empty;
        _newRewardCost = 1;
        _isAdding = false;
    }

    // Smaže odměnu podle Id a uloží aktualizovaný seznam do localStorage
    private async Task DeleteRewardAsync(string id)
    {
        _rewards = _rewards
            .Where(reward => reward.Id != id)
            .ToList();

        await Storage.SetObjectAsync("userCustomRewards", _rewards);
    }

    // Tlačítko Koupit je neaktivní, pokud uživatel nemá dost kreditů
    private static string GetBuyButtonClass(bool canBuy)
    {
        if (canBuy)
        {
            return "ui-btn-small ui-btn-primary";
        }

        return "ui-btn-small ui-btn-secondary cursor-not-allowed opacity-50";
    }

    // Formátuje slovo kredit podle počtu
    private static string FormatCredits(int credits)
    {
        if (credits == 1)
        {
            return "1 kredit";
        }

        if (credits >= 2 && credits <= 4)
        {
            return $"{credits} kredity";
        }

        return $"{credits} kreditů";
    }

    private sealed class RewardItem
    {
        public string Id { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public int Cost { get; set; }
    }
}
