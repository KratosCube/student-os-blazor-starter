@inject BrowserStorageService Storage
@inject NavigationManager Navigation

@if (_loaded)
{
    @*
        GoalTracker zobrazuje dnešní odstudovaný čas, denní cíl a kredity.
        Nastavení cíle, poměru kreditů a bonusu za splnění cíle se ukládá do localStorage.
    *@
    <div class="ui-card p-5">
        <div class="mb-4 flex items-start justify-between">
            <div class="flex items-center gap-2">
                <i class="bi bi-award text-xl text-amber-400" aria-hidden="true"></i>
                <h3 class="ui-card-title">Denní progress</h3>
            </div>

            <button type="button"
                    class="ui-btn-small ui-btn-secondary gap-2 px-3 text-xs"
                    title="Nastavení cílů"
                    aria-label="Nastavení cílů"
                    @onclick="ToggleSettings">
                <i class="bi bi-sliders" aria-hidden="true"></i>
                <span>Nastavení</span>
            </button>
        </div>

        @if (_showSettings)
        {
            @*
                Nastavení umožňuje změnit denní studijní cíl, poměr pro výpočet kreditů a bonus za splnění cíle.
                Hodnoty se po uložení zachovají i po obnovení stránky.
            *@
            <div class="ui-settings-panel">
                <div class="space-y-4">
                    <div>
                        <label class="ui-label">Denní cíl (hodiny)</label>

                        <input type="number"
                               min="1"
                               max="24"
                               @bind="_goalHours"
                               class="ui-input" />
                    </div>

                    <div>
                        <label class="ui-label">1 kredit za (minut)</label>

                        <input type="number"
                               min="5"
                               max="600"
                               @bind="_minutesPerCredit"
                               class="ui-input" />
                    </div>

                    @* Bonus určuje, kolik kreditů se přičte po splnění denního cíle. *@
                    <div>
                        <label class="ui-label">Kredity za splnění denního cíle</label>

                        <input type="number"
                               min="0"
                               max="100"
                               @bind="_goalRewardCredits"
                               class="ui-input" />
                    </div>

                    <button type="button"
                            class="ui-btn-primary w-full"
                            @onclick="SaveSettingsAsync">
                        Uložit
                    </button>
                </div>
            </div>
        }
        else
        {
            
            <div class="mb-4 flex items-end justify-between">
                <div>
                    <p class="ui-text-helper">Dnes</p>
                    <p class="text-lg font-semibold text-slate-800 dark:text-slate-100">
                        @Hours h @Minutes m
                    </p>
                </div>

                <div class="text-right">
                    <p class="ui-text-helper">Cíl</p>
                    <p class="text-sm font-medium text-slate-600 dark:text-slate-300">
                        @_goalHours h
                    </p>
                </div>
            </div>

            <div class="mb-5">
                <div class="ui-progress-bar-track">
                    <div class="ui-progress-bar-fill"
                         style="width:@($"{ProgressPercent}%")">
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <button type="button"
                        class="ui-progress-card ui-progress-card-warning text-left"
                        title="Přejít na reward shop"
                        @onclick="GoToRewardShop">
                    <div>
                        <p class="ui-progress-card-label-warning">
                            Kredity
                        </p>

                        <p class="ui-progress-card-value-warning">
                            @Credits
                        </p>
                    </div>

                    <p class="ui-progress-card-text-warning">
                        @CreditDescription
                    </p>
                </button>

                <div class="ui-progress-card ui-progress-card-primary">
                    <div>
                        <p class="ui-progress-card-label-primary">
                            Další za
                        </p>

                        <div class="mt-2 flex items-baseline gap-1 whitespace-nowrap">
                            <span class="ui-progress-card-value-primary">
                                @MinutesToNext
                            </span>

                            <span class="text-lg font-semibold text-indigo-700 dark:text-indigo-300">
                                m
                            </span>
                        </div>
                    </div>

                    <p class="ui-progress-card-text-primary">
                        Do dalšího kreditu
                    </p>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public int TodayMinutes { get; set; }

    private double _goalHours = 4;
    private int _minutesPerCredit = 45;
    private int _goalRewardCredits = 1;
    private bool _showSettings;
    private bool _loaded;
    
    // Po prvním vykreslení se načte uložené nastavení denního cíle a kreditů
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var savedGoal = await Storage.GetStringAsync("userGoalHours");
        var savedRatio = await Storage.GetStringAsync("userRewardRatio");
        var savedGoalReward = await Storage.GetStringAsync("userGoalRewardCredits");

        if (double.TryParse(savedGoal, out var goal))
            _goalHours = goal;

        if (int.TryParse(savedRatio, out var ratio))
            _minutesPerCredit = ratio;

        if (int.TryParse(savedGoalReward, out var goalReward))
            _goalRewardCredits = Math.Max(0, goalReward);

        _loaded = true;
        StateHasChanged();
    }

    // Uloží denní cíl, poměr kreditů a bonus za splnění cíle do localStorage
    private async Task SaveSettingsAsync()
    {
        await Storage.SetStringAsync("userGoalHours", _goalHours.ToString(System.Globalization.CultureInfo.InvariantCulture));
        await Storage.SetStringAsync("userRewardRatio", _minutesPerCredit.ToString());
        await Storage.SetStringAsync("userGoalRewardCredits", Math.Max(0, _goalRewardCredits).ToString());
        _showSettings = false;
    }

    private void GoToRewardShop()
    {
        Navigation.NavigateTo("/stats#reward-shop");
    }

    // Otevře nebo zavře formulář s nastavením.
    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
    }



    // Denní cíl převod z hodin na minuty.
    private int GoalMinutes
    {
        get
        {
            return (int)(_goalHours * 60);
        }
    } 

    private bool IsGoalCompleted
    {
        get
        {
            return GoalMinutes > 0 && TodayMinutes >= GoalMinutes;
        }
    }

    private double ProgressPercent
    {
        get
        {
            if (GoalMinutes == 0)
            {
                return 0;
            }

            var percent = (TodayMinutes / (double)GoalMinutes) * 100;

            return Math.Min(percent, 100);
        }
    }
    
    private int Credits
    {
        get
        {
            if (_minutesPerCredit <= 0)
            {
                return 0;
            }

            var credits = TodayMinutes / _minutesPerCredit;

            if (IsGoalCompleted)
            {
                credits += Math.Max(0, _goalRewardCredits);
            }

            return credits;
        }
    }

    private string CreditDescription
    {
        get
        {
            if (IsGoalCompleted && _goalRewardCredits > 0)
            {
                return $"Včetně bonusu +{_goalRewardCredits}";
            }

            return "Otevřít odměny";
        }
    }

    private int MinutesToNext
    {
        get
        {
            if (_minutesPerCredit <= 0)
                return 0;

            if (TodayMinutes == 0)
                return _minutesPerCredit;

            var remainder = TodayMinutes % _minutesPerCredit;
            if (remainder == 0)
            {
                return 0;
            }

            return _minutesPerCredit - remainder;
        }
    }

    private int Hours
    {
        get
        {
            return TodayMinutes / 60;
        }
    }

    private int Minutes
    {
        get
        {
            return TodayMinutes % 60;
        }
    }
}
