@inject ThemeService ThemeService

<button @onclick="ToggleAsync"
        class="inline-flex h-12 w-12 aspect-square shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-white p-0 text-slate-600 shadow-sm transition-all hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
        title="@ButtonTitle"
        aria-label="@ButtonTitle">
    <i class="@ButtonIconClass" aria-hidden="true"></i>
</button>

@code {
    private bool _darkMode;
    
    private string ButtonTitle
    {
        get
        {
            if (_darkMode)
            {
                return "Přepnout na světlý režim";
            }

            return "Přepnout na tmavý režim";
        }
    }

    private string ButtonIconClass
    {
        get
        {
            if (_darkMode)
            {
                return "bi bi-sun text-xl";
            }

            return "bi bi-moon-stars text-xl";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var theme = await ThemeService.GetThemeAsync();
        _darkMode = theme == "dark";
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        var theme = await ThemeService.ToggleThemeAsync();
        _darkMode = theme == "dark";
    }
}
