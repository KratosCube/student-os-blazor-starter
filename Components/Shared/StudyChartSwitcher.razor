@using StudentOs.Blazor.Services

<div class="space-y-4">
    <div class="flex flex-wrap gap-3">
        <button type="button"
                @onclick="() => _mode = ChartMode.Week"
                class="@(_mode == ChartMode.Week ? "ui-btn-primary" : "ui-btn-secondary")">
            Po dnech
        </button>

        <button type="button"
                @onclick="() => _mode = ChartMode.Subjects"
                class="@(_mode == ChartMode.Subjects ? "ui-btn-primary" : "ui-btn-secondary")">
            Podle předmětů
        </button>
    </div>

    @*
        Samotné vykreslení grafu řeší komponenta StudyBarChart
        Tato komponenta pouze vybírá, jaká data se do grafu pošlou.
    *@
    <StudyBarChart
        Title="@ChartTitle"
        Description="@ChartDescription"
        Items="@ChartItems" />
</div>

@code {
    [Parameter]
    public List<ChartItemVm> WeeklySeries { get; set; } = new();

    [Parameter]
    public List<ChartItemVm> SubjectSeries { get; set; } = new();

    private ChartMode _mode = ChartMode.Week;

   private string ChartTitle
    {
        get
        {
            if (_mode == ChartMode.Week)
            {
                return "Studium za posledních 7 dní";
            }

            return "Studium podle předmětů";
        }
    }

    private string ChartDescription
    {
        get
        {
            if (_mode == ChartMode.Week)
            {
                return "Přehled vytížení po dnech.";
            }

            return "Přehled celkové investice času po předmětech.";
        }
    }

    private List<ChartItemVm> ChartItems
    {
        get
        {
            if (_mode == ChartMode.Week)
            {
                return WeeklySeries;
            }

            return SubjectSeries;
        }
    }

    private enum ChartMode
    {
        Week,
        Subjects
    }
}
