@implements IDisposable
@inject BrowserStorageService Storage
@inject StudySessionService StudySessionService
@inject IJSRuntime JS

<div class="ui-card p-5 @(_mode == TimerMode.Break ? "ui-focus-break" : string.Empty)">
    <div class="mb-4 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="13" r="8"></circle>
                <path d="M12 9v4l2.5 2.5"></path>
                <path d="M9 3h6"></path>
            </svg>

            <h3 class="ui-card-title">
                @(_mode == TimerMode.Work ? "Focus Mode" : "Pauza")
            </h3>
        </div>

        <button @onclick="SwitchModeAsync" class="ui-btn-small ui-btn-secondary px-3 text-xs">
            @(_mode == TimerMode.Work ? "Pauza" : "Práce")
        </button>
    </div>

    @if (_mode == TimerMode.Work)
    {
        <div class="mb-5">
            <select value="@(_selectedSubjectId?.ToString() ?? string.Empty)"
                    @onchange="OnSubjectChanged"
                    class="ui-select"
                    disabled="@_isActive">
                <option value="">Vyber předmět</option>

                @foreach (var subject in Subjects)
                {
                    <option value="@subject.Id">@subject.Name</option>
                }
            </select>
        </div>
    }

    <div class="mb-6 text-center">
        <div class="ui-timer-display">
            @FormatTime(_timeLeftSeconds)
        </div>
    </div>

    <div class="flex items-center justify-center gap-3">
        <button @onclick="ToggleTimerAsync"
                disabled="@(_mode == TimerMode.Work && _selectedSubjectId is null && !_isActive)"
                class="@GetStartPauseButtonClass()">
            @if (_isActive)
            {
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="6" y="5" width="4" height="14" rx="1"></rect>
                    <rect x="14" y="5" width="4" height="14" rx="1"></rect>
                </svg>
                <span>Pauza</span>
            }
            else
            {
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"></path>
                </svg>
                <span>Start</span>
            }
        </button>

        <button @onclick="ResetTimerAsync"
                class="ui-icon-btn"
                aria-label="Resetovat timer">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 3-6.7"></path>
                <path d="M3 3v6h6"></path>
            </svg>
        </button>
    </div>

    @if (_mode == TimerMode.Work && _selectedSubjectId is null)
    {
        <p class="ui-warning-text mt-4 text-center">
            Vyber předmět pro start.
        </p>
    }
</div>

@code {
    [Parameter]
    public List<Subject> Subjects { get; set; } = new();

    private int? _selectedSubjectId;
    private int _timeLeftSeconds = 25 * 60;
    private bool _isActive;
    private TimerMode _mode = TimerMode.Work;
    private CancellationTokenSource? _tickerCts;
    private long? _targetUnixMs;
    private bool _loaded;
    private bool _finishing;

    private readonly int _pauseTime = 5;
    private readonly int _mainTime = 25;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var savedSubject = await Storage.GetStringAsync("timerSubject");

        if (int.TryParse(savedSubject, out var subjectId))
        {
            _selectedSubjectId = subjectId;
        }

        var savedTarget = await Storage.GetStringAsync("timerTarget");

        if (long.TryParse(savedTarget, out var targetUnixMs))
        {
            _targetUnixMs = targetUnixMs;

            var diff = GetRemainingSeconds(targetUnixMs);

            if (diff > 0)
            {
                _timeLeftSeconds = diff;
                _isActive = true;
                StartTicker();
            }
            else
            {
                await Storage.RemoveAsync("timerTarget");
                _timeLeftSeconds = GetDefaultSeconds();
            }
        }

        _loaded = true;
        StateHasChanged();
    }

    private async Task OnSubjectChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();

        if (int.TryParse(raw, out var value))
        {
            _selectedSubjectId = value;

            if (_loaded)
            {
                await Storage.SetStringAsync("timerSubject", value.ToString());
            }
        }
        else
        {
            _selectedSubjectId = null;

            if (_loaded)
            {
                await Storage.RemoveAsync("timerSubject");
            }
        }
    }

    private async Task ToggleTimerAsync()
    {
        if (!_isActive)
        {
            if (_mode == TimerMode.Work && _selectedSubjectId is null)
                return;

            await TryUnlockSoundAsync();

            _targetUnixMs = DateTimeOffset.Now.ToUnixTimeMilliseconds() + (_timeLeftSeconds * 1000L);
            await Storage.SetStringAsync("timerTarget", _targetUnixMs.Value.ToString());

            if (_selectedSubjectId is not null)
            {
                await Storage.SetStringAsync("timerSubject", _selectedSubjectId.Value.ToString());
            }

            _isActive = true;
            StartTicker();

            return;
        }

        _isActive = false;
        _targetUnixMs = null;

        StopTicker();

        await Storage.RemoveAsync("timerTarget");
        StateHasChanged();
    }

    private async Task ResetTimerAsync()
    {
        _isActive = false;
        _targetUnixMs = null;

        StopTicker();

        _timeLeftSeconds = GetDefaultSeconds();

        await Storage.RemoveAsync("timerTarget");

        StateHasChanged();
    }

    private async Task SwitchModeAsync()
    {
        _mode = _mode == TimerMode.Work
            ? TimerMode.Break
            : TimerMode.Work;

        _isActive = false;
        _targetUnixMs = null;

        StopTicker();

        _timeLeftSeconds = GetDefaultSeconds();

        await Storage.RemoveAsync("timerTarget");

        StateHasChanged();
    }

    private void StartTicker()
    {
        StopTicker();

        _tickerCts = new CancellationTokenSource();
        _ = RunTickerAsync(_tickerCts.Token);
    }

    private async Task RunTickerAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(TickAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private void StopTicker()
    {
        if (_tickerCts is null)
            return;

        try
        {
            _tickerCts.Cancel();
        }
        catch
        {
        }

        _tickerCts.Dispose();
        _tickerCts = null;
    }

    private async Task TickAsync()
    {
        if (!_isActive || _targetUnixMs is null)
            return;

        var diff = GetRemainingSeconds(_targetUnixMs.Value);

        if (diff <= 0)
        {
            if (_timeLeftSeconds != 0)
            {
                _timeLeftSeconds = 0;
                StateHasChanged();
            }

            await FinishTimerAsync();
            return;
        }

        if (diff == _timeLeftSeconds)
            return;

        _timeLeftSeconds = diff;
        StateHasChanged();
    }

    private async Task FinishTimerAsync()
    {
        if (_finishing)
            return;

        _finishing = true;

        var finishedMode = _mode;

        try
        {
            _isActive = false;
            _targetUnixMs = null;

            StopTicker();

            await Storage.RemoveAsync("timerTarget");

            if (finishedMode == TimerMode.Work && _selectedSubjectId is not null)
            {
                await StudySessionService.AddAsync(new StudySession
                {
                    SubjectId = _selectedSubjectId.Value,
                    Duration = _mainTime,
                    CreatedAt = DateTime.Now
                });
            }

            await TryPlayBeepAsync();

            await TryShowFinishAlertAsync(finishedMode);

            await SwitchModeAsync();
        }
        finally
        {
            _finishing = false;
        }
    }

    private async Task TryUnlockSoundAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("appSound.unlock");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task TryPlayBeepAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("appSound.beep");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task TryShowFinishAlertAsync(TimerMode finishedMode)
    {
        try
        {
            await JS.InvokeVoidAsync(
                "alert",
                finishedMode == TimerMode.Work
                    ? "Hotovo! Dej si pauzu."
                    : "Pauza končí. Zpátky do práce."
            );
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private static int GetRemainingSeconds(long targetUnixMs)
    {
        var remainingMs = targetUnixMs - DateTimeOffset.Now.ToUnixTimeMilliseconds();

        if (remainingMs <= 0)
            return 0;

        return (int)Math.Ceiling(remainingMs / 1000d);
    }

    private int GetDefaultSeconds()
    {
        return _mode == TimerMode.Work
            ? _mainTime * 60
            : _pauseTime * 60;
    }

    private static string FormatTime(int seconds)
    {
        var minutes = seconds / 60;
        var restSeconds = seconds % 60;

        return $"{minutes:00}:{restSeconds:00}";
    }

    private string GetStartPauseButtonClass()
    {
        if (_isActive)
        {
            return "ui-timer-btn ui-timer-btn-active";
        }

        if (_mode == TimerMode.Work && _selectedSubjectId is null)
        {
            return "ui-timer-btn ui-timer-btn-disabled";
        }

        return "ui-timer-btn ui-timer-btn-primary";
    }

    public void Dispose()
    {
        StopTicker();
    }

    private enum TimerMode
    {
        Work,
        Break
    }
}
