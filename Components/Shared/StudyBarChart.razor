@using System.Globalization
@using StudentOs.Blazor.Services

@*
    StudyBarChart je vlastní komponenta pro vykreslení sloupcového grafu.
    Používá se na Dashboardu a ve Stats pro zobrazení odstudovaného času.
*@
<div class="ui-card p-6">
    <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h3 class="ui-section-title">@Title</h3>
            }

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="ui-text-secondary mt-2">@Description</p>
            }
        </div>

        @if (HeaderActions is not null)
        {
            <div class="flex flex-wrap gap-2">
                @HeaderActions
            </div>
        }
    </div>

    <div class="ui-chart-area">
        @if (Items.Count == 0 || Items.All(x => x.TotalValue == 0))
        {
            <div class="flex h-[210px] items-center justify-center">
                <p class="ui-text-secondary text-center">
                    Zatím tu nejsou žádná data ke zobrazení.
                </p>
            </div>
        }
        else
        {
            @*
                Sloupce jsou vykreslené pomocí CSS gridu.
                Počet sloupců a mezery se dopočítávají podle množství položek v grafu
            *@
            <div class="grid items-end" style="@GridStyle">
                @foreach (var item in Items)
                {
                    var heightPercent = MaxValue == 0
                    ? 0
                    : (item.TotalValue / (double)MaxValue) * 100;

                    var finalHeight = Math.Max(heightPercent, item.TotalValue > 0 ? 8 : 0);

                    <div class="min-w-0">
                        <div class="ui-chart-value">
                            @if (item.TotalValue > 0)
                            {
                                <span title="@($"{item.TotalValue} min")">
                                    @FormatTopValue(item.TotalValue)
                                </span>
                            }
                        </div>

                        <div class="flex h-[210px] items-end justify-center">
                            <div class="ui-chart-bar" style="@GetBarStyle(finalHeight)">
                                @foreach (var segment in item.Segments)
                                {
                                    var segmentHeight = item.TotalValue == 0
                                    ? 0
                                    : (segment.Value / (double)item.TotalValue) * 100;

                                    <div class="ui-chart-segment"
                                         style="@GetSegmentStyle(segmentHeight, segment.Color)"
                                         title="@segment.Label: @segment.Value min">
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="ui-chart-label" style="font-size:@LabelFontSize;" title="@item.Label">
                            @item.Label
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public List<ChartItemVm> Items { get; set; } = new();

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    // Graf nemá co vykreslit, pokud neobsahuje žádné položky
    private int MaxValue => Math.Max(Items.Count == 0 ? 0 : Items.Max(x => x.TotalValue), 1);

    private string GridStyle
    {
        get
        {
            var count = Math.Max(Items.Count, 1);
            var gap = count > 20 ? "0.35rem" : "0.75rem";

            return $"grid-template-columns: repeat({count}, minmax(0, 1fr)); gap: {gap};";
        }
    }

    private string BarMaxWidth
    {
        get
        {
            if (Items.Count > 24)
            {
                return "26px";
            }

            if (Items.Count > 14)
            {
                return "34px";
            }

            return "50px";
        }
    }

    private string LabelFontSize
    {
        get
        {
            if (Items.Count > 24)
            {
                return "0.68rem";
            }

            if (Items.Count > 14)
            {
                return "0.75rem";
            }

            return "0.875rem";
        }
    }

    private string GetBarStyle(double heightPercent)
    {
        return $"height:{FormatCssPercent(heightPercent)}; max-width:{BarMaxWidth};";
    }

    private static string GetSegmentStyle(double heightPercent, string color)
    {
        return $"height:{FormatCssPercent(heightPercent)}; background-color:{color};";
    }

    private static string FormatCssPercent(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture) + "%";
    }

    private static string FormatTopValue(int minutes)
    {
        if (minutes >= 1000)
            return $"{minutes / 60}h";

        return $"{minutes}m";
    }
}