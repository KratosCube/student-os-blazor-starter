@using StudentOs.Blazor.Services

<div class="ui-card p-6">
    <div class="mb-5 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h3 class="ui-section-title">@Title</h3>
            }

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="ui-text-secondary mt-2">@Description</p>
            }
        </div>

        @if (HeaderActions is not null)
        {
            <div class="flex flex-wrap gap-2">
                @HeaderActions
            </div>
        }
    </div>

    <div class="w-full overflow-hidden rounded-xl bg-slate-100 px-4 py-5 dark:bg-slate-950">
        @if (Items.Count == 0 || Items.All(x => x.TotalValue == 0))
        {
            <div class="flex h-[210px] items-center justify-center">
                <p class="ui-text-secondary text-center">
                    Zatím tu nejsou žádná data ke zobrazení.
                </p>
            </div>
        }
        else
        {
            <div class="grid items-end"
                 style="@GridStyle">
                @foreach (var item in Items)
                {
                    var heightPercent = MaxValue == 0
                        ? 0
                        : (item.TotalValue / (double)MaxValue) * 100;

                    var finalHeight = Math.Max(heightPercent, item.TotalValue > 0 ? 8 : 0);

                    <div class="min-w-0">
                        <div class="mb-3 text-center text-xs font-medium text-slate-500 dark:text-slate-300"
                             style="height:16px;">
                            @if (item.TotalValue > 0)
                            {
                                <span title="@($"{item.TotalValue} min")">
                                    @FormatTopValue(item.TotalValue)
                                </span>
                            }
                        </div>

                        <div class="flex h-[210px] items-end justify-center">
                            <div class="flex w-full flex-col justify-end overflow-hidden rounded-t-xl shadow-sm transition-all duration-500"
                                 style="height:@($"{finalHeight}%"); max-width:@BarMaxWidth;">
                                @foreach (var segment in item.Segments)
                                {
                                    var segmentHeight = item.TotalValue == 0
                                        ? 0
                                        : (segment.Value / (double)item.TotalValue) * 100;

                                    <div class="w-full cursor-help border-b border-white/10 transition-all hover:brightness-125"
                                         style="height:@($"{segmentHeight}%"); background-color:@segment.Color"
                                         title="@segment.Label: @segment.Value min">
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-3 truncate text-center font-medium text-slate-700 dark:text-slate-200"
                             style="font-size:@LabelFontSize;"
                             title="@item.Label">
                            @item.Label
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public List<ChartItemVm> Items { get; set; } = new();

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    private int MaxValue => Math.Max(Items.Count == 0 ? 0 : Items.Max(x => x.TotalValue), 1);

    private string GridStyle
    {
        get
        {
            var count = Math.Max(Items.Count, 1);
            var gap = count > 20 ? "0.35rem" : "0.75rem";

            return $"grid-template-columns: repeat({count}, minmax(0, 1fr)); gap: {gap};";
        }
    }

    private string BarMaxWidth => Items.Count switch
    {
        > 24 => "26px",
        > 14 => "34px",
        _ => "50px"
    };

    private string LabelFontSize => Items.Count switch
    {
        > 24 => "0.68rem",
        > 14 => "0.75rem",
        _ => "0.875rem"
    };

    private static string FormatTopValue(int minutes)
    {
        if (minutes >= 1000)
            return $"{minutes / 60}h";

        return $"{minutes}m";
    }
}
