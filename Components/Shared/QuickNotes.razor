@inject BrowserStorageService Storage
@inject IJSRuntime JS

<div class="ui-card group relative flex min-h-[190px] h-fit flex-col p-5 transition-colors">
    <div class="mb-1 flex items-center justify-between">
        <h3 class="ui-card-title flex items-center gap-2">
            <i class="bi bi-pencil-square text-indigo-400" aria-hidden="true"></i>
            Rychlé poznámky
        </h3>

        <span class="ui-text-helper opacity-0 transition-opacity group-hover:opacity-100">
            Automaticky uloženo
        </span>
    </div>
    @*
        Textarea používá @oninput místo @bind, aby se poznámka ukládala průběžně při psaní
        Po změně se dopočítá výška textarea přes JavaScript helper
    *@
    <textarea @ref="_textareaRef"
              value="@Note"
              @oninput="OnInput"
              placeholder="Napiš si sem cokoli... (odkazy se objeví dole)"
              rows="1"
              class="ui-textarea notes-lines block overflow-hidden text-slate-700 dark:text-slate-300"
              style="background-attachment: local; padding-top: 0px; min-height: 150px;"></textarea>

    @if (Links.Count > 0)
    {
        <div class="mt-3 flex flex-wrap gap-2 pt-1">
            @foreach (var link in Links)
            {
                <a href="@link"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex items-center gap-1 rounded-md border border-indigo-200 bg-indigo-50 px-2 py-1 text-xs text-indigo-700 hover:underline dark:border-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-300"
                   title="@link">
                    <i class="bi bi-box-arrow-up-right text-[0.7rem]" aria-hidden="true"></i>
                    @GetHostname(link)
                </a>
            }
        </div>
    }
</div>

@code {
    private string Note = string.Empty;
    private List<string> Links = new();
    private bool _loaded;
    private bool _shouldAutoGrow;
    private ElementReference _textareaRef;

    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Po prvním vykreslení se načte uložená poznámka z localStorage
            var saved = await Storage.GetStringAsync("userQuickNotes");

            if (!string.IsNullOrWhiteSpace(saved))
            {
                Note = saved;
                ExtractLinks(saved);
            }

            _loaded = true;
            _shouldAutoGrow = true;
            StateHasChanged();
            return;
        }

        if (_shouldAutoGrow)
        {
            _shouldAutoGrow = false;
            await JS.InvokeVoidAsync("appNotes.autoGrow", _textareaRef);
        }
    }

    // Reaguje na každé psaní do textarea
    private async Task OnInput(ChangeEventArgs e)
    {
        Note = e.Value?.ToString() ?? string.Empty;
        ExtractLinks(Note);

        if (_loaded)
        {
            await Storage.SetStringAsync("userQuickNotes", Note);
        }

        _shouldAutoGrow = true;
    }

    // Najde v textu všechny URL adresy začínající http:// nebo https://
    private void ExtractLinks(string text)
    {
        var matches = System.Text.RegularExpressions.Regex.Matches(
            text,
            @"(https?:\/\/[^\s]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        Links = matches
            .Select(x => x.Value)
            // Odstranuje duplicity
            .Distinct()
            .ToList();
    }

    private static string GetHostname(string link)
    {
        try
        {
            return new Uri(link).Host;
        }
        catch
        {
            return link;
        }
    }
}
