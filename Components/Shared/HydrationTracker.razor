@implements IDisposable
@inject BrowserStorageService Storage

@*
    Uživatel si nastaví interval připomenutí a velikost sklenice
    Stav se ukládá do localStorage, aby se po obnovení stránky neztratil
*@
<div class="ui-card p-5">
    <div class="mb-4 flex items-start justify-between">
        <div class="flex items-center gap-2">
            <i class="bi bi-droplet-half text-xl text-sky-500" aria-hidden="true"></i>
            <h3 class="ui-card-title">Voda</h3>
        </div>

        <button type="button"
                class="ui-settings-btn"
                title="Nastavení pitného režimu"
                aria-label="Nastavení pitného režimu"
                @onclick="ToggleSettings">
            <i class="bi bi-sliders" aria-hidden="true"></i>
        </button>
    </div>

    @if (_showSettings)
    {
        @*
            Nastavení pitného režimu
            Hodnoty se po uložení zapíšou do localStorage
        *@
        <div class="ui-settings-panel">
            <div class="space-y-4">
                <div>
                    <label class="ui-label">Interval (minuty)</label>

                    <input type="number"
                           min="5"
                           max="240"
                           @bind="_intervalMinutes"
                           class="ui-input" />
                </div>

                <div>
                    <label class="ui-label">Velikost sklenice (ml)</label>

                    <input type="number"
                           min="50"
                           max="1000"
                           @bind="_glassSize"
                           class="ui-input" />
                </div>

                <button type="button"
                        class="ui-btn-primary w-full"
                        @onclick="SaveSettingsAsync">
                    Uložit
                </button>
            </div>
        </div>
    }
    else
    {
        
        <div class="mb-4 flex items-end justify-between">
            <div>
                <p class="ui-text-helper">Dnes</p>

                <p class="text-lg font-semibold text-slate-800 dark:text-slate-100">
                    @_totalMl ml
                </p>
            </div>

            <div class="text-right">
                <p class="ui-text-helper">Další připomenutí</p>

                <p class="text-sm font-medium text-slate-600 dark:text-slate-300">
                    @RemainingMinutes min
                </p>
            </div>
        </div>

        <div class="mb-5 flex flex-col items-center">
            <div class="ui-hydration-glass">
                <div class="ui-hydration-water"
                     style="height:@($"{_progress}%")">
                    <div class="ui-hydration-wave"></div>
                    <div class="ui-hydration-wave-slow"></div>
                </div>

                <div class="ui-hydration-percent-wrapper">
                    <span class="@GetPercentTextClass()">
                        @(_isEmpty ? "0%" : $"{Math.Round(_progress)}%")
                    </span>
                </div>
            </div>
        </div>

        <button type="button"
                class="@GetDrinkButtonClass()"
                title="@($"Přičíst {_glassSize} ml")"
                @onclick="HandleDrinkAsync">
            @if (_isEmpty)
            {
                <span>NAPÍT SE!</span>
            }
            else
            {
                <span>@_glassSize ml</span>
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
            }
        </button>
    }
</div>

@code {
    private double _progress = 100;
    private bool _isEmpty;
    private bool _showSettings;
    private int _totalMl;
    private int _intervalMinutes = 60;
    private int _glassSize = 250;
    private long _lastDrinkUnixMs;
    private System.Threading.Timer? _timer;

    // Po prvním renderu se načte stav pitného režimu z localStorage
    // Spustí se časovač, který každou sekundu aktualizuje hladinu vody.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var savedInterval = await Storage.GetStringAsync("hydrationInterval");
        var savedGlassSize = await Storage.GetStringAsync("hydrationGlassSize");
        var savedTotalMl = await Storage.GetStringAsync("hydrationTotalMl");
        var savedDate = await Storage.GetStringAsync("hydrationDate");
        var savedLastDrink = await Storage.GetStringAsync("hydrationLastDrink");

        if (int.TryParse(savedInterval, out var interval))
        {
            _intervalMinutes = interval;
        }

        if (int.TryParse(savedGlassSize, out var glassSize))
        {
            _glassSize = glassSize;
        }

        var today = DateTime.Now.ToString("yyyy-MM-dd");

        // Pokud je uložené datum jiné než dnešní, denní součet vody se vynuluje.
        if (savedDate != today)
        {
            _totalMl = 0;

            await Storage.SetStringAsync("hydrationDate", today);
            await Storage.SetStringAsync("hydrationTotalMl", "0");
        }
        else if (int.TryParse(savedTotalMl, out var totalMl))
        {
            _totalMl = totalMl;
        }

        if (long.TryParse(savedLastDrink, out var lastDrink))
        {
            _lastDrinkUnixMs = lastDrink;
        }
        else
        {
            _lastDrinkUnixMs = DateTimeOffset.Now.ToUnixTimeMilliseconds();

            await Storage.SetStringAsync("hydrationLastDrink", _lastDrinkUnixMs.ToString());
        }

        UpdateWaterLevel();
        StartTicker();

        StateHasChanged();
    }

    // Otevře nebo zavře nastavení pitného režimu.
    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
    }

    // Spustí interní časovač
    // Každou sekundu přepočítá, kolik času zbývá do dalšího připomenutí
    private void StartTicker()
    {
        _timer?.Dispose();

        _timer = new System.Threading.Timer(
            async _ =>
            {
                UpdateWaterLevel();
                await InvokeAsync(StateHasChanged);
            },
            null,
            1000,
            1000
        );
    }

    // Přepočítá aktuální hladinu vody podle času od posledního napití
    // Po celém intervalu, se sklenice označí jako prázdná
    private void UpdateWaterLevel()
    {
        var intervalMilliseconds = _intervalMinutes * 60 * 1000.0;
        var elapsedMilliseconds = DateTimeOffset.Now.ToUnixTimeMilliseconds() - _lastDrinkUnixMs;

        if (elapsedMilliseconds >= intervalMilliseconds)
        {
            _progress = 0;
            _isEmpty = true;

            return;
        }

        _progress = Math.Max(0, 100 - ((elapsedMilliseconds / intervalMilliseconds) * 100));
        _isEmpty = false;
    }

    // Přičte velikost sklenice k dennímu součtu a resetuje odpočet
    private async Task HandleDrinkAsync()
    {
        _lastDrinkUnixMs = DateTimeOffset.Now.ToUnixTimeMilliseconds();
        _totalMl += _glassSize;

        await Storage.SetStringAsync("hydrationLastDrink", _lastDrinkUnixMs.ToString());
        await Storage.SetStringAsync("hydrationTotalMl", _totalMl.ToString());
        await Storage.SetStringAsync("hydrationDate", DateTime.Now.ToString("yyyy-MM-dd"));

        _progress = 100;
        _isEmpty = false;
    }

    // Uloží nastavení pitného režimu a resetuje odpočet
    private async Task SaveSettingsAsync()
    {
        await Storage.SetStringAsync("hydrationInterval", _intervalMinutes.ToString());
        await Storage.SetStringAsync("hydrationGlassSize", _glassSize.ToString());

        _showSettings = false;
        _lastDrinkUnixMs = DateTimeOffset.Now.ToUnixTimeMilliseconds();

        await Storage.SetStringAsync("hydrationLastDrink", _lastDrinkUnixMs.ToString());

        _progress = 100;
        _isEmpty = false;
    }

    // Zbývající čas do dalšího připomenutí v minutách
    private int RemainingMinutes
    {
        get
        {
            var remaining = Math.Round((_progress / 100.0) * _intervalMinutes);

            return Math.Max(0, (int)remaining);
        }
    }

    // Text ve sklenici bílý, když je hladina vysoko,
    // jinak tmavší kvůli čitelnosti.
    private string GetPercentTextClass()
    {
        if (_progress > 50)
        {
            return "ui-hydration-percent ui-hydration-percent-filled";
        }

        return "ui-hydration-percent ui-hydration-percent-empty";
    }

    // Styl tlačítka podle toho, jestli už má uživatel pít.
    private string GetDrinkButtonClass()
    {
        if (_isEmpty)
        {
            return "ui-hydration-drink-btn ui-hydration-drink-btn-empty";
        }

        return "ui-hydration-drink-btn ui-hydration-drink-btn-ready";
    }

    // Při zničení komponenty zastavit timer
    public void Dispose()
    {
        _timer?.Dispose();
    }
}
